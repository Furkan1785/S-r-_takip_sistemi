<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blue_purple_gradient_bg"
    tools:context=".Admingiris">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAdminLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="15dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="25dp">

            <ImageButton
                android:id="@+id/btnkapat"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:layout_gravity="end"
                app:tint="#757575"
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:contentDescription="Kapat"/>
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/ic_secure"
                android:layout_gravity="center_horizontal"
                app:tint="#D32F2F"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yönetici Paneli"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="30dp"/>

            <EditText
                android:id="@+id/etAdminUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Kullanıcı Adı"
                android:inputType="text"
                android:background="@drawable/edittext_solid_white_round"
                android:padding="15dp"
                android:maxLength="20"
                android:drawableStart="@android:drawable/ic_menu_myplaces"
                android:drawablePadding="10dp"
                android:drawableTint="#546E7A"
                android:layout_marginBottom="15dp"/>

            <EditText
                android:id="@+id/etAdminPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Yönetici Şifresi"
                android:inputType="textPassword"
                android:maxLength="20"
                android:background="@drawable/edittext_solid_white_round"
                android:padding="15dp"
                android:drawableStart="@drawable/kilitresmi"
                android:drawablePadding="10dp"
                android:drawableTint="#546E7A"
                android:layout_marginBottom="25dp"/>

            <Button
                android:id="@+id/btnAdminLoginAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GİRİŞ YAP"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:paddingVertical="12dp"
                android:elevation="5dp"
                app:cornerRadius="10dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>