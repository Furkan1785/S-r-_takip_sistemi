<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavigationView"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Piyasa Takip Paneli"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Güncel referans fiyatlar (UKON &amp; USK)"
                    android:textSize="12sp"
                    android:textColor="#757575"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥩 Bölgesel Dana Kesim Fiyatları"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="5dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="25dp">

                <TableLayout
                    android:id="@+id/tabloEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp">
                    <TableRow
                        android:background="#FFEBEE"
                        android:padding="10dp">
                        <TextView
                            android:text="BÖLGE"
                            android:textStyle="bold"
                            android:textColor="#C62828"/>
                        <TextView
                            android:text="FİYAT (₺)"
                            android:textStyle="bold"
                            android:textColor="#C62828"
                            android:gravity="end"/>
                    </TableRow>
                </TableLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥛 Çiğ Süt Tavsiye Fiyatları"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="5dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="20dp">

                <TableLayout
                    android:id="@+id/tabloSut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    >

                    <TableRow
                        android:background="#E3F2FD"
                        android:padding="10dp">
                        <TextView
                            android:text="DÖNEM"
                            android:textStyle="bold"
                            android:textColor="#1565C0"/>
                        <TextView
                            android:text="FİYAT (₺)"
                            android:textStyle="bold"
                            android:textColor="#1565C0"
                            android:gravity="end"/>
                    </TableRow>
                </TableLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnYenile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Listeyi Yenile"
                android:layout_gravity="center"
                android:backgroundTint="#FF9800"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="30dp"/>

        </LinearLayout>
    </ScrollView>


</RelativeLayout>